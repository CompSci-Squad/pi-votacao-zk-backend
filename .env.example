# Ethereum RPC endpoint (e.g. Sepolia via Infura or Alchemy)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Address of the deployed VotingContract
CONTRACT_ADDRESS=0xYourContractAddressHere

# Private key of the admin account (used to sign transactions)
# WARNING: never commit real private keys — use secrets management in production
ADMIN_PRIVATE_KEY=0xYourPrivateKeyHere

# Comma-separated list of allowed CORS origins (use * for development only)
CORS_ORIGINS=http://localhost:3000
