# ── server ────────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# ── blockchain ────────────────────────────────────────────────────────────────
# JSON-RPC endpoint; defaults to local dockerized anvil
RPC_URL=http://127.0.0.1:8545
# Address of the deployed VotingFactory contract
FACTORY_ADDRESS=0x...

# ── relayer ───────────────────────────────────────────────────────────────────
# Private key of the EOA that submits castVote transactions on behalf of voters.
# MUST hold enough ETH to cover gas.
RELAYER_PRIVATE_KEY=0x...

# ── rate limiting ─────────────────────────────────────────────────────────────
# Max proofs per voter token per minute (set to max picks per race, usually 1)
RATE_LIMIT_COUNT=10
RATE_WINDOW_MS=60000

# ── pending-proofs log ────────────────────────────────────────────────────────
# Directory where per-epoch pending-proof logs are written (created if missing)
PENDING_LOG_DIR=./pending-logs
# Epoch window in milliseconds (default: 5 minutes)
EPOCH_WINDOW_MS=300000
# Set to "true" to call factory.auditAnchor() at every epoch rotation.
# The RELAYER_PRIVATE_KEY must be the factory auditor when this is enabled.
AUDIT_ANCHOR_ENABLED=false
