{
  "name": "pi-votacao-zk-backend",
  "version": "1.0.0",
  "description": "Stateless Node.js/TypeScript backend for the ZK anonymous voting system",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "npm run test:unit",
    "pretest:unit": "tsc -p tsconfig.test.json",
    "test:unit": "mocha 'dist-test/test/unit/**/*.test.js' --timeout 20000",
    "pretest:integration": "tsc -p tsconfig.test.json",
    "test:integration": "mocha 'dist-test/test/integration/**/*.test.js' --timeout 60000"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.19",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "mocha": "^10.7.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
